# Dataset folders hold licensed Alpaca market data (raw bars, quotes, per-symbol prices) and
# snapshots. Only aggregate, price-free outputs are committed; manifest.json records sha256 of inputs.
reports/datasets/*/*
!reports/datasets/*/report.md
!reports/datasets/*/manifest.json
!reports/datasets/*/eligibility.csv
!reports/datasets/*/quote_probe_summary.json
!reports/datasets/*/backtest_summary_*.json
